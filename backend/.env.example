NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=loom_app
DB_PASSWORD=loom_app_password
DB_NAME=loom
DB_POOL_SIZE=10
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Required to store user-supplied provider keys securely (use a long random secret).
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
CORS_ORIGIN=http://localhost:5173
# Optional platform-managed provider keys. User keys are encrypted in MySQL.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
PROJECTS_ROOT=./workspaces
REVIEW_MAX_ATTEMPTS=2
