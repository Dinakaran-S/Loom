NODE_ENV=development
PORT=4000
POSTGRES_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DB_POOL_SIZE=10
# Supabase Auth. Use the project URL (not the /rest/v1 URL) and the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key from Project Settings > API. Never put this in frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Required to store user-supplied provider keys securely (use a long random secret).
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
CORS_ORIGIN=http://localhost:5173
# Optional platform-managed provider keys. User keys are encrypted in Postgres.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
PROJECTS_ROOT=./workspaces
REVIEW_MAX_ATTEMPTS=2
