NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=loom_app
DB_PASSWORD=loom_app_password
DB_NAME=loom
DB_POOL_SIZE=10


# JWT — generate long random strings, never reuse across envs
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins, no wildcard in prod
CORS_ORIGIN=http://localhost:5173

# AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Generated project workspaces and review repair passes
PROJECTS_ROOT=./workspaces
REVIEW_MAX_ATTEMPTS=2
