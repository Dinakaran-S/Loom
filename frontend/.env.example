# Browser-safe values from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used after email confirmation. Set this to the deployed URL
# on Vercel; local development falls back to the current Vite origin.
VITE_AUTH_REDIRECT_URL=https://your-app.example.com

# URL of the Loom Express API.
VITE_API_URL=http://localhost:4000/api
